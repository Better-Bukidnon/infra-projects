{
  "name": "infra-projects",
  "version": "0.1.0",
  "private": true,
  "description": "infra.betterbukidnon.org: Bukidnon DPWH infrastructure projects map and table, sourced from Bisto.ph / BetterGov DPWH API. A Better Bukidnon site.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "serve": "python -m http.server 8080",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
